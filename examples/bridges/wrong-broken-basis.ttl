@prefix ga:     <https://tesseractsemantics.com/ns/asset-passport/ga#> .
@prefix game:   <https://tesseractsemantics.com/ns/asset-passport/game/> .
@prefix bridge: <https://tesseractsemantics.com/ns/asset-passport/bridge/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

# Wrong on purpose: a map into a made-up game whose sourced east and north are
# the same axis. The game is in facts/wrong-broken-basis.ttl, which a run reads
# only with --facts. Its basis has no handedness at all, so the facts check
# refuses it, and so does the handedness check of any map into it.
bridge:wrong-broken-basis a ga:Bridge ; rdfs:label "Map into a broken basis" ;
    ga:host game:broken-basis ; ga:guest game:minecraft ; ga:evidenceLevel "synthetic test" ;
    ga:guestXFrom "+x" ; ga:guestYFrom "+z" ; ga:guestZFrom "-y" .
