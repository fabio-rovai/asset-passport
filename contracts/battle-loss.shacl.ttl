@prefix ga:  <https://tesseractsemantics.com/ns/asset-passport/ga#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix c: <https://tesseractsemantics.com/ns/asset-passport/contract/battle#> .

# What a thing loses on the way into Pocket Battlers. Warnings: it still enters,
# and its passport names what had nowhere to go.

c:NoBonusHealth a sh:NodeShape ; sh:targetClass ga:Item ;
    sh:property [ sh:path ga:bonusHealth ; sh:maxCount 0 ; sh:severity sh:Warning ;
        sh:message "Pocket Battlers has no health above the maximum, so the bonus HP is dropped." ] .
