@prefix ga:     <https://tesseractsemantics.com/ns/asset-passport/ga#> .
@prefix game:   <https://tesseractsemantics.com/ns/asset-passport/game/> .
@prefix bridge: <https://tesseractsemantics.com/ns/asset-passport/bridge/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

# Wrong on purpose: two guest axes read off one host axis, so the map
# flattens the world.
bridge:wrong-degenerate-map a ga:Bridge ; rdfs:label "Two axes onto one" ; ga:host game:skyrim ; ga:guest game:minecraft ; ga:evidenceLevel "synthetic test" ;
    ga:declaredHostUnitsPerGuestUnit 70 ;
    ga:guestXFrom "+x" ; ga:guestYFrom "+x" ; ga:guestZFrom "-y" .
