@prefix ga:   <https://tesseractsemantics.com/ns/asset-passport/ga#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# The Game Asset core. Every game maps its own words into this hub, so N games
# need N mappings, not N squared. It says what a thing IS. Numbers stay in the
# source game's units until the receiving game's declared rule converts them.

<https://tesseractsemantics.com/ns/asset-passport/ga> a owl:Ontology ;
    rdfs:label "Asset Passport: Game Asset core" ; owl:versionInfo "0.3.0" .

ga:Item a owl:Class ; rdfs:label "Item" ;
    rdfs:comment "Anything that can cross from one game into another: a tool, a consumable, a creature." .
ga:Weapon a owl:Class ; rdfs:subClassOf ga:Item ; rdfs:label "Weapon" .
ga:Explosive a owl:Class ; rdfs:subClassOf ga:Item ; rdfs:label "Explosive" ;
    rdfs:comment "Deals its damage to everything near it at once." .
ga:HealingConsumable a owl:Class ; rdfs:subClassOf ga:Item ; rdfs:label "Healing consumable" .
ga:CaptureDevice a owl:Class ; rdfs:subClassOf ga:Item ; rdfs:label "Capture device" ;
    rdfs:comment "Makes a wild creature belong to the player." .
ga:Creature a owl:Class ; rdfs:subClassOf ga:Item ; rdfs:label "Creature" .
ga:Game a owl:Class ; rdfs:label "Game" .

ga:ElementalType a owl:Class ; rdfs:label "Elemental type" .
ga:Normal a ga:ElementalType . ga:Fire a ga:ElementalType . ga:Water a ga:ElementalType .
ga:Grass a ga:ElementalType . ga:Rock a ga:ElementalType . ga:Steel a ga:ElementalType .

# ------------------------------------------------ what a thing has, in source units
ga:fromGame a owl:ObjectProperty ; rdfs:range ga:Game ;
    rdfs:comment "The game whose units every number on this thing is written in." .
ga:importTarget a owl:ObjectProperty ; rdfs:range ga:Game ;
    rdfs:comment "The customs declaration: the receiving game states it, and the conversion rule reads it." .
ga:madeOf a owl:ObjectProperty ; rdfs:label "made of" .
ga:elementalType a owl:ObjectProperty ; rdfs:range ga:ElementalType ; rdfs:label "elemental type" .
ga:baseDamage a owl:DatatypeProperty ; rdfs:comment "Damage of one hit or one move, in the source game's hit points." .
ga:healAmount a owl:DatatypeProperty ; rdfs:comment "Hit points restored, in the source game's hit points." .
ga:bonusHealth a owl:DatatypeProperty ; rdfs:comment "Health granted above the maximum. Not every game allows it." .
ga:hitPoints a owl:DatatypeProperty ; rdfs:comment "A creature's own health, in the source game's hit points." .
ga:moveName a owl:DatatypeProperty ; rdfs:comment "What a creature's attack is called." .

# ------------------------------------------------ what a game declares about itself
ga:maxPlayerHealth a owl:DatatypeProperty ; rdfs:domain ga:Game .
ga:wholeNumbersOnly a owl:DatatypeProperty ; rdfs:domain ga:Game .
ga:hasElementalTypes a owl:DatatypeProperty ; rdfs:domain ga:Game ;
    rdfs:comment "True when every move in this game has an elemental type." .
ga:exportKey a owl:DatatypeProperty ; rdfs:domain ga:Game ;
    rdfs:comment "The Ed25519 public key this game signs its passports with, as base64 of the raw 32 bytes. A receiving game verifies a passport against the key in its own copy of the issuing game's published profile, never against a key the passport carries." .

# ------------------------------------------------ what the receiving game's rule produced
ga:damageInTarget a owl:DatatypeProperty . ga:healInTarget a owl:DatatypeProperty .
ga:hitPointsInTarget a owl:DatatypeProperty . ga:typeInTarget a owl:ObjectProperty .
