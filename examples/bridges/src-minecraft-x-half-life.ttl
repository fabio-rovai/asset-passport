@prefix ga:     <https://tesseractsemantics.com/ns/asset-passport/ga#> .
@prefix game:   <https://tesseractsemantics.com/ns/asset-passport/game/> .
@prefix bridge: <https://tesseractsemantics.com/ns/asset-passport/bridge/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

# Read from the project's own source at a pinned commit, not from the table.

bridge:src-minecraft-x-half-life a ga:Bridge ; rdfs:label "Minecraft x Half-Life (link code)" ;
    ga:host game:half-life ; ga:guest game:minecraft ;
    ga:guestXFrom "+x" ; ga:guestYFrom "+z" ; ga:guestZFrom "-y" ;
    ga:declaredHostUnitsPerGuestUnit 40 ;
    ga:evidenceLevel "source inspection" ;
    ga:project <https://github.com/SawyerTheNerd/Minecraft-X-HalfLife/blob/fecf40cfbbdc22b30e7a4f31d8d221923d546532/link/mclink_shared.cpp#L92-L97> ;
    ga:sourceCommit "fecf40cfbbdc22b30e7a4f31d8d221923d546532" ;
    ga:quote "mc[0] = hl[0] / kUnitsPerBlock; mc[1] = hl[2] / kUnitsPerBlock; mc[2] = -hl[1] / kUnitsPerBlock;" ,
             "link/bsp_collision.h lines 15-16: // 1 Minecraft block == 40 Half-Life units: Gordon's 72-unit hull is Steve's 1.8 blocks. constexpr double kUnitsPerBlock = 40.0;" ;
    ga:note "The code states 72 units as 1.8 blocks, not 1.8 metres; with Minecraft's 1-metre block the two are the same ratio, so only the 40 per block is declared here." .
