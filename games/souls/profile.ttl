@prefix ga:    <https://tesseractsemantics.com/ns/asset-passport/ga#> .
@prefix souls: <https://tesseractsemantics.com/ns/asset-passport/souls#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# Ashen: a side-on souls-like duel. One length unit is one centimetre. A player
# has 1,000 hit points. Armour is absorption in percent. Every swing costs
# stamina, poise decides who staggers, and death sends the player back to the
# last bonfire, which also refills the flask. The bonfire is the whole loop.

souls:game a ga:Game ;
    rdfs:label "Ashen" ;
    ga:maxPlayerHealth 1000 ;
    ga:metresPerLengthUnit 0.01 ;
    ga:maxArmourRating 100 ;
    ga:damageReductionAtMaxArmour 1.0 ;
    ga:defaultStaminaCost 18 ;
    ga:wholeNumbersOnly true .

# ---------------------------------------------- Ashen's own words, mapped into the hub

souls:Item a owl:Class ; rdfs:subClassOf ga:Item ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ga:fromGame ; owl:hasValue souls:game ] .

souls:Greatsword a owl:Class ; rdfs:subClassOf ga:TwoHandedWeapon ; rdfs:label "Greatsword" .
souls:EmberFlask a owl:Class ; rdfs:subClassOf ga:HealingConsumable ; rdfs:label "Ember flask" .
souls:KnightArmour a owl:Class ; rdfs:subClassOf ga:BodyArmour ; rdfs:label "Knight armour" .

souls:attackRating a owl:DatatypeProperty ; rdfs:subPropertyOf ga:baseDamage .
souls:bladeLengthCm a owl:DatatypeProperty ; rdfs:subPropertyOf ga:length .
souls:absorption a owl:DatatypeProperty ; rdfs:subPropertyOf ga:armourRating .
souls:restoresHp a owl:DatatypeProperty ; rdfs:subPropertyOf ga:healAmount .
souls:poiseDamage a owl:DatatypeProperty ; rdfs:subPropertyOf ga:poise .
souls:stamina a owl:DatatypeProperty ; rdfs:subPropertyOf ga:staminaCost .
souls:refillsAtBonfire a owl:DatatypeProperty ; rdfs:subPropertyOf ga:refillsAtCheckpoint .
souls:name a owl:DatatypeProperty ; rdfs:subPropertyOf rdfs:label .
