# The conversion policy both games declare: PROPORTIONAL. Damage, healing and a
# creature's health keep their share of a player's health: 7 of Blockcraft's 20
# HP is 35%, and 35% of a creature's 100 HP is 35. The elemental type passes
# through to a game that has types. This is a policy, not a fact. A game that
# wants absolute damage writes another rule. Lean does not check this file. It
# is published with the games' profiles, so anyone can run it again on a passport.
#
# EVERY arithmetic chain below is fully parenthesised, and that is load-bearing.
# Oxigraph's SPARQL parser (spargebra 0.5, upstream and in the engine's fork)
# groups chains to the RIGHT: it reads 7/20*100 as 7/(20*100) = 0.0035 and
# 8-3-2 as 8-(3-2) = 7. The SPARQL 1.1 grammar makes both left-associative.
# tests/test_verdicts.py pins the numbers so the bug cannot come back silently.
#
# It reads the customs declaration `?item ga:importTarget ?target` that the
# receiving game asserts, so one rule serves both directions.

PREFIX ga: <https://tesseractsemantics.com/ns/asset-passport/ga#>

CONSTRUCT {
  ?item ga:damageInTarget    ?dmg ;
        ga:healInTarget      ?heal ;
        ga:hitPointsInTarget ?hp ;
        ga:typeInTarget      ?type .
}
WHERE {
  ?item ga:importTarget ?tgt ;
        ga:fromGame     ?src .
  ?src ga:maxPlayerHealth ?srcHp .
  ?tgt ga:maxPlayerHealth ?tgtHp .
  OPTIONAL { ?tgt ga:wholeNumbersOnly ?w }
  BIND (COALESCE(?w, false) AS ?whole)

  OPTIONAL { ?item ga:baseDamage ?d }
  BIND (((?d / ?srcHp) * ?tgtHp) AS ?dRaw)
  BIND (IF(?whole, ROUND(?dRaw), ?dRaw) AS ?dmg)

  OPTIONAL { ?item ga:healAmount ?h }
  BIND (((?h / ?srcHp) * ?tgtHp) AS ?hRaw)
  BIND (IF(?whole, ROUND(?hRaw), ?hRaw) AS ?heal)

  OPTIONAL { ?item ga:hitPoints ?p }
  BIND (((?p / ?srcHp) * ?tgtHp) AS ?pRaw)
  BIND (IF(?whole, ROUND(?pRaw), ?pRaw) AS ?hp)

  # A type crosses only into a game that declares it has types.
  OPTIONAL { ?tgt ga:hasElementalTypes true . ?item ga:elementalType ?type }
}
