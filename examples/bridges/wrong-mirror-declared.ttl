@prefix ga:     <https://tesseractsemantics.com/ns/asset-passport/ga#> .
@prefix game:   <https://tesseractsemantics.com/ns/asset-passport/game/> .
@prefix bridge: <https://tesseractsemantics.com/ns/asset-passport/bridge/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

# Wrong on purpose: a mirror that is declared, but along the wrong direction.
# The map flips north (guest z = host +y), while the bridge says it flips east.
# Handedness holds (a mirror is declared and the map mirrors), and the axis
# check names the two axes that disagree with an east-west mirror.
bridge:wrong-mirror-declared a ga:Bridge ; rdfs:label "Mirror declared along the wrong direction" ; ga:host game:skyrim ; ga:guest game:minecraft ; ga:evidenceLevel "synthetic test" ;
    ga:declaredHostUnitsPerGuestUnit 70 ;
    ga:guestXFrom "+x" ; ga:guestYFrom "+z" ; ga:guestZFrom "+y" ;
    ga:mirrored true ; ga:mirrorDirection ga:East .
