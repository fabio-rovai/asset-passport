@prefix ga:     <https://tesseractsemantics.com/ns/asset-passport/ga#> .
@prefix game:   <https://tesseractsemantics.com/ns/asset-passport/game/> .
@prefix bridge: <https://tesseractsemantics.com/ns/asset-passport/bridge/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

# Wrong on purpose: Half-Life health is 100 and Minecraft health is 20, so the
# proportional multiplier is 5, not 4.
bridge:wrong-health-multiplier a ga:Bridge ; rdfs:label "Health times 4" ;
    ga:host game:half-life ; ga:guest game:minecraft ; ga:evidenceLevel "synthetic test" ;
    ga:declaredHealthMultiplier 4 .
